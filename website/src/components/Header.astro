---
// Replaces Starlight's default header lockup. Two reasons: the default is
// the most recognisable "this is a Starlight site" tell, and the version
// chip belongs next to the name — a reader should never have to wonder
// which release the page in front of them describes.
import type { Props } from '@astrojs/starlight/props'
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro'

// VersionSearch comes from starlight-versions rather than Starlight. This
// header is a config-level component override, which wins over the
// plugin's own, so the plugin's version would never render unless
// imported here. It scopes results to the version being read — searching
// from an archived page must not return pages about a release you are not
// on. The switcher is ours; see VersionSwitcher.astro for why.
import VersionSearch from 'starlight-versions/components/VersionSearch.astro'

import VersionSwitcher from './VersionSwitcher.astro'

import ThemeToggle from './ThemeToggle.astro'
---

<div class="header-inner">
  <a href="/" class="lockup">
    <img class="mark on-light" src="/icon.svg" alt="" width="30" height="30" />
    <img class="mark on-dark" src="/icon-dark.svg" alt="" width="30" height="30" />
    <span class="wordmark">catena</span>
  </a>

  <div class="right">
    <VersionSwitcher />
    <VersionSearch {...Astro.props} />
    <div class="controls">
      <ThemeToggle />
      <SocialIcons {...Astro.props} />
    </div>
  </div>
</div>

<style>
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--sl-color-white);
  }

  /* The mark has two fixed colours, so it cannot follow currentColor —
     each theme gets its own file and the other is hidden. */
  :global(:root[data-theme='dark']) .on-light,
  :global(:root:not([data-theme='dark'])) .on-dark {
    display: none;
  }

  .wordmark {
    font-family: var(--catena-display);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    font-variation-settings: 'opsz' 30;
  }

  .right {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: 1;
    justify-content: flex-end;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
</style>
