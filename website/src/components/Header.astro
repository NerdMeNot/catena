---
// Replaces Starlight's default header lockup. Two reasons: the default is
// the most recognisable "this is a Starlight site" tell, and the version
// chip belongs next to the name — a reader should never have to wonder
// which release the page in front of them describes.
import type { Props } from '@astrojs/starlight/props'
import Search from '@astrojs/starlight/components/Search.astro'
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro'

import ThemeToggle from './ThemeToggle.astro'

import site from '../data/site.json'
---

<div class="header-inner">
  <a href="/" class="lockup">
    <img class="mark on-light" src="/icon.svg" alt="" width="30" height="30" />
    <img class="mark on-dark" src="/icon-dark.svg" alt="" width="30" height="30" />
    <span class="wordmark">catena</span>
    <span class="version" title={`These docs describe catena v${site.version}`}>
      v{site.version}
    </span>
  </a>

  <div class="right">
    <Search {...Astro.props} />
    <div class="controls">
      <ThemeToggle />
      <SocialIcons {...Astro.props} />
    </div>
  </div>
</div>

<style>
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--sl-color-white);
  }

  /* The mark has two fixed colours, so it cannot follow currentColor —
     each theme gets its own file and the other is hidden. */
  :global(:root[data-theme='dark']) .on-light,
  :global(:root:not([data-theme='dark'])) .on-dark {
    display: none;
  }

  .wordmark {
    font-family: var(--catena-display);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    font-variation-settings: 'opsz' 30;
  }

  /* The version is a fact about the page, so it is stated plainly rather
     than styled as a badge shouting for attention. */
  .version {
    font-family: var(--catena-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--sl-color-gray-3);
    background: var(--catena-chip);
    border: 1px solid var(--catena-rule);
    border-radius: 999px;
    padding: 0.12rem 0.45rem;
    letter-spacing: 0.01em;
  }

  .right {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: 1;
    justify-content: flex-end;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  @media (max-width: 50rem) {
    .version {
      display: none;
    }
  }
</style>
