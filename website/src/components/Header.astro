---
// Replaces Starlight's default header lockup. Two reasons: the default is
// the most recognisable "this is a Starlight site" tell, and the version
// chip belongs next to the name — a reader should never have to wonder
// which release the page in front of them describes.
import type { Props } from '@astrojs/starlight/props'
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro'

// Both come from starlight-versions rather than Starlight. This header is
// a config-level component override, which wins over the plugin's own, so
// the plugin's versions of these would never render unless imported here.
// VersionSearch scopes results to the version being read — searching from
// an archived page must not return pages about a release you are not on.
import VersionSearch from 'starlight-versions/components/VersionSearch.astro'
import VersionSelect from 'starlight-versions/components/VersionSelect.astro'

import ThemeToggle from './ThemeToggle.astro'
---

<div class="header-inner">
  <a href="/" class="lockup">
    <img class="mark on-light" src="/icon.svg" alt="" width="30" height="30" />
    <img class="mark on-dark" src="/icon-dark.svg" alt="" width="30" height="30" />
    <span class="wordmark">catena</span>
  </a>

  <div class="right">
    <div class="version"><VersionSelect /></div>
    <VersionSearch {...Astro.props} />
    <div class="controls">
      <ThemeToggle />
      <SocialIcons {...Astro.props} />
    </div>
  </div>
</div>

<style>
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--sl-color-white);
  }

  /* The mark has two fixed colours, so it cannot follow currentColor —
     each theme gets its own file and the other is hidden. */
  :global(:root[data-theme='dark']) .on-light,
  :global(:root:not([data-theme='dark'])) .on-dark {
    display: none;
  }

  .wordmark {
    font-family: var(--catena-display);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    font-variation-settings: 'opsz' 30;
  }

  /* The version is a fact about the page and now also the control that
     changes it, so it keeps the chip's quiet styling rather than becoming
     a second thing competing with the wordmark. */
  .version :global(select) {
    font-family: var(--catena-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .version :global(label) {
    color: var(--sl-color-gray-3);
    background: var(--catena-chip);
    border: 1px solid var(--catena-rule);
    border-radius: 999px;
    padding: 0.05rem 0.3rem;
  }

  .right {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: 1;
    justify-content: flex-end;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  @media (max-width: 50rem) {
    .version {
      display: none;
    }
  }
</style>
